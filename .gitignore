# Local verification environments
**/.venv/
**/.pytest_cache/
**/__pycache__/
**/*.py[cod]
verification/**/.venv/
work-product/verification/**/.venv/
work-product/verification/**/.tools/
work-product/verification/**/.mamba-root/

# Python bytecode generated by local verification runs
**/__pycache__/
*.py[cod]

# Runtime logs generated by verification scripts
verification/**/logs/*.log
work-product/verification/**/logs/*.log
work-product/verification/**/outputs/
work-product/verification/**/assets/habitat_wrist_camera_probe.glb

# Dora runtime session folders generated during verification
verification/**/out/
work-product/verification/**/out/

# Heavy/generated verification artifacts. Curated tutorial images live under
# work-product/*/src/assets/ instead.
verification/**/artifacts/
work-product/verification/**/artifacts/

# Local-only workspaces and publishing notes. Keep generated examples, raw
# recordings, transcripts, and platform-specific export notes out of PRs.
work-product/verification/habitat-camera-sensors/
work-product/videos/

# Dora recording outputs
*.drec

# mdBook generated output
book/
work-product/book/
